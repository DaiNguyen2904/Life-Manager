<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Theme chính của ứng dụng (Material Design 3, nền sáng) -->
    <style name="Theme.LifeManager" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lm_primary</item>
        <item name="colorOnPrimary">@color/lm_white</item>
        <item name="colorPrimaryContainer">@color/lm_blue</item>
        <item name="colorOnPrimaryContainer">@color/lm_text_primary</item>
        <item name="colorSecondary">@color/lm_primary</item>
        <item name="colorOnSecondary">@color/lm_white</item>
        <item name="colorSecondaryContainer">@color/lm_nav_indicator</item>
        <item name="colorOnSecondaryContainer">@color/lm_text_primary</item>
        <item name="colorTertiary">@color/lm_primary_dark</item>
        <item name="colorError">@color/lm_danger</item>
        <item name="android:colorBackground">@color/lm_background</item>
        <item name="colorOnBackground">@color/lm_text_primary</item>
        <item name="colorSurface">@color/lm_background</item>
        <item name="colorOnSurface">@color/lm_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/lm_text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/lm_white</item>
        <item name="colorSurfaceContainerLow">#F3F1F8</item>
        <item name="colorSurfaceContainer">@color/lm_nav_background</item>
        <item name="colorSurfaceContainerHigh">@color/lm_card</item>
        <item name="colorSurfaceContainerHighest">@color/lm_card</item>
        <item name="colorOutline">#9C9BA8</item>
        <item name="colorOutlineVariant">@color/lm_divider</item>
        <item name="android:textColorPrimary">@color/lm_text_primary</item>
        <item name="android:textColorSecondary">@color/lm_text_secondary</item>
        <item name="android:windowBackground">@color/lm_background</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.LifeManager.Dialog</item>
    </style>

    <style name="ThemeOverlay.LifeManager.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/lm_background</item>
        <item name="colorPrimary">@color/lm_primary</item>
    </style>

    <!-- Kiểu chữ dùng chung -->
    <style name="TextAppearance.LifeManager.ScreenTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lm_text_primary</item>
    </style>

    <style name="TextAppearance.LifeManager.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lm_text_primary</item>
    </style>

    <style name="TextAppearance.LifeManager.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/lm_text_secondary</item>
    </style>

    <style name="TextAppearance.LifeManager.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.LifeManager.TabSmall" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Card dùng chung -->
    <style name="Widget.LifeManager.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/lm_card</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.LifeManager.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/lm_white</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">3dp</item>
    </style>

    <style name="Widget.LifeManager.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabIndicatorColor">@color/lm_primary</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabSelectedTextColor">@color/lm_text_primary</item>
        <item name="tabTextColor">@color/lm_text_secondary</item>
        <item name="tabTextAppearance">@style/TextAppearance.LifeManager.Tab</item>
        <item name="tabRippleColor">@color/lm_nav_indicator</item>
    </style>

    <style name="Widget.LifeManager.ProgressBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">6dp</item>
        <item name="trackCornerRadius">3dp</item>
        <item name="indicatorColor">@color/lm_primary</item>
        <item name="trackColor">@color/lm_white</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>

    <style name="Widget.LifeManager.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/lm_nav_indicator</item>
    </style>

</resources>
